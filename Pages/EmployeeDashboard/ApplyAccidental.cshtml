@page
@model University_HR_ManagementSystem.Pages.EmployeeDashboard.ApplyAccidentalModel
@{
    ViewData["Title"] = "Apply Accidental Leave";
    Layout = "_MinLayout";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="~/css/dashboard.css" />

<style>
    .form-card {
        width: 600px;
        margin: 45px auto;
        background: #fffdf2;
        border-radius: 25px;
        padding: 40px;
        border: 4px solid #ffb30033;
        box-shadow: 0px 20px 45px rgba(0, 0, 0, 0.10);
        animation: fadeIn 0.5s ease-out;
        text-align: center;
    }

    .page-title {
        font-size: 30px;
        font-weight: bold;
        color: #ffb300;
        margin-bottom: 15px;
    }

    .page-title i {
        margin-right: 8px;
    }

    label {
        font-weight: 600;
        margin-bottom: 6px;
    }

    .form-control {
        height: 48px;
        border-radius: 10px;
        font-size: 16px;
        border: 2px solid #ffd766;
    }

    .btn-primary-action {
        background: #ffb300;
        border: none;
        color: white;
        width: 100%;
        padding: 14px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 17px;
        transition: 0.25s ease;
    }

    .btn-primary-action:hover {
        background: #e09e00;
        transform: translateY(-3px);
        box-shadow: 0px 12px 25px rgba(255,193,7,0.35);
    }

    .btn-back {
        width: 100%;
        margin-top: 15px;
        background: #6c757d;
        color: white;
        padding: 14px;
        font-size: 16px;
        border-radius: 12px;
        transition: 0.25s ease;
        font-weight: 600;
    }

    .btn-back:hover {
        background: #555;
        transform: translateY(-3px);
        box-shadow: 0px 10px 20px rgba(0,0,0,0.15);
    }

    .alert {
        border-radius: 10px;
        font-size: 16px;
        margin-bottom: 15px;
    }
    
    .button-wrapper {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

</style>


<div class="form-card">

    <div class="page-title">
        <i class="fa-solid fa-triangle-exclamation"></i> Apply Accidental Leave
    </div>

    <p class="text-muted">For sudden emergencies — limited to **one day only**.</p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger fade-in">
            <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
        </div>
    }

    <form method="post" class="mt-3">

        <div class="mb-3">
            <label class="form-label fw-bold">Leave Date</label>
            <input type="date" asp-for="LeaveDate" class="form-control" required />
        </div>

        <div class="button-wrapper">
            <button type="submit" class="btn-primary-action">
                <i class="fa-solid fa-paper-plane"></i> Submit Request
            </button>

            <a asp-page="/EmployeeDashboard/ApplyLeave" class="btn-back">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
        </div>

    </form>
</div>
