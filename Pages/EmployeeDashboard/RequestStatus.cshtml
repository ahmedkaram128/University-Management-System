@page
@model University_HR_ManagementSystem.Pages.Employee.RequestStatusModel
@{
    ViewData["Title"] = "Leave Requests Status";
    Layout = "_MinLayout";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link rel="stylesheet" href="~/css/dashboard.css" />

<style>
    .content-card {
        width: 900px;
        margin: 40px auto;
        background: #ffffff;
        padding: 40px;
        border-radius: 25px;
        box-shadow: 0px 20px 45px rgba(0,0,0,0.10);
        animation: fadeIn 0.6s ease-out;
        text-align: center;
    }

    table {
        border-radius: 12px;
        overflow: hidden;
        font-size: 16px;
    }

    .table thead {
        background: #0d6efd !important;
        color: white;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 10px;
        font-weight: 600;
        display: inline-block;
    }

    .status-approved {
        background: #d4edda;
        color: #155724;
    }

    .status-rejected {
        background: #f8d7da;
        color: #a00000;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .btn-back {
        background: #6c757d;
        border: none;
        padding: 12px 30px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        transition: 0.25s ease;
        color: white;
    }

    .btn-back:hover {
        background: #555;
        transform: translateY(-3px);
        box-shadow: 0px 10px 22px rgba(0,0,0,0.15);
    }

    .empty-row {
        font-size: 18px;
        color: #6c757d;
        padding: 20px;
        font-weight: 500;
    }

    .empty-row i {
        color: #0d6efd;
        margin-right: 6px;
    }
</style>



<div class="content-card">

    <h2 class="dashboard-title mb-4">
        <i class="fa-solid fa-clock-rotate-left"></i> Leave Request History
    </h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger text-center fade-in">
            <i class="fa-solid fa-triangle-exclamation"></i> @Model.ErrorMessage
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped text-center mt-3">

            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Date Submitted</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Requests == null || Model.Requests.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="empty-row">
                            <i class="fa-solid fa-calendar-xmark"></i>
                            No leave requests found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var r in Model.Requests)
                    {
                        <tr>
                            <td>@r.RequestID</td>
                            <td>@r.DateOfRequest</td>
                            <td>
                                <span class="status-badge
                                    @(r.Status.ToLower() == "approved" ? "status-approved" :
                                      r.Status.ToLower() == "rejected" ? "status-rejected" :
                                      "status-pending")">
                                    @r.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>

    <a asp-page="/EmployeeDashboard/EmployeeDashboard" class="btn-back mt-4">
        <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
    </a>

</div>
